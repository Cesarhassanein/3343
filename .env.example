# ==============================================================================
# Wadiq Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# ==============================================================================

# Server Network Settings
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Storage Provider Strategy: 'telegram' | 'local'
STORAGE_PROVIDER=telegram

# ------------------------------------------------------------------------------
# 1. Telegram Integration Configuration
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Channel IDs
TELEGRAM_STORAGE_CHANNEL_IMAGES=
TELEGRAM_STORAGE_CHANNEL_REELS=
TELEGRAM_STORAGE_CHANNEL_VOICE=
TELEGRAM_COMMUNITY_SUPERGROUP_ID=

# Telegram Rate Limiting
TELEGRAM_RATE_LIMIT_OPS_PER_SEC=25

# Telegram Webhook Secret
TELEGRAM_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ------------------------------------------------------------------------------
# 3. Agora RTC Engine Configuration
# ------------------------------------------------------------------------------
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRATION_SECONDS=3600

# ------------------------------------------------------------------------------
# 4. JWT Authentication Secret
# ------------------------------------------------------------------------------
JWT_SECRET=generate_a_strong_random_secret_here

# ------------------------------------------------------------------------------
# 5. Local Cache & Temporary Vault
# ------------------------------------------------------------------------------
MEDIA_CACHE_DIR=./storage/cache
MEDIA_MAX_CACHE_SIZE_MB=500
